meta {
  name: Create finance
  type: http
  seq: 2
}
post {
  url: {{baseUrl}}/api/v1/invoices
  body: json
  auth: bearer
}
auth:bearer {
  token: {{accessToken}}
}
headers {
  Content-Type: application/json
}
body:json {
  {"quoteId":"{{quoteId}}","issueDate":"2026-09-29","dueDate":"2026-10-29","tax":"0.00","notes":"Payment due within 30 days"}
}
assert {
  res.status: eq 201
}
