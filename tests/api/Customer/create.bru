meta {
  name: Create customer
  type: http
  seq: 2
}
post {
  url: {{baseUrl}}/api/v1/customers
  body: json
  auth: bearer
}
headers {
  Content-Type: application/json
}
auth:bearer {
  token: {{accessToken}}
}
body:json {
  { "name": "Bruno test customer", "status": "prospect" }
}
assert {
  res.status: eq 201
  res.body.data.name: eq Bruno test customer
}
